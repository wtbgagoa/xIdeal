            "xAct`xIdeal`Private`x", ",", "xAct`xIdeal`Private`y", ",", 
             "xAct`xIdeal`Private`z"}], "}"}], ",", 
           RowBox[{"\[Sqrt]", 
            RowBox[{"(", 
             RowBox[{
