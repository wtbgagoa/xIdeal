 CellChangeTimes->{{3.956648284765217*^9, 3.956648287617296*^9}},
 CellID->493712759,ExpressionUUID->"b6de754d-bd01-4975-9ff0-6c3d3cba74ec"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"PerfectFluidQ", "[", 
   RowBox[{"metric", ",", " ", "w"}], "]"}]], "InlineFormula",ExpressionUUID->
  "ee462089-bcfd-49c8-8c40-e6af9a5ae212"],
 " returns True if metric is of the perfect fluid type. To do so, it needs an \
arbitrary unitary time-like vector w."
}], "Usage",
