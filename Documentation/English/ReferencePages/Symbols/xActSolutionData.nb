Cell[BoxData[
 RowBox[{"Function", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "xAct`xIdeal`Private`coords", ",", "xAct`xIdeal`Private`params", ",", 
     "xAct`xIdeal`Private`scfuncs"}], "}"}], ",", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"xAct`xIdeal`Private`t", "=", 
        RowBox[{
        "xAct`xIdeal`Private`coords", "\[LeftDoubleBracket]", "1", 
         "\[RightDoubleBracket]"}]}], ",", 
       RowBox[{"xAct`xIdeal`Private`x", "=", 
        RowBox[{
        "xAct`xIdeal`Private`coords", "\[LeftDoubleBracket]", "2", 
         "\[RightDoubleBracket]"}]}], ",", 
       RowBox[{"xAct`xIdeal`Private`y", "=", 
        RowBox[{
        "xAct`xIdeal`Private`coords", "\[LeftDoubleBracket]", "3", 
         "\[RightDoubleBracket]"}]}], ",", 
       RowBox[{"xAct`xIdeal`Private`z", "=", 
        RowBox[{
        "xAct`xIdeal`Private`coords", "\[LeftDoubleBracket]", "4", 
         "\[RightDoubleBracket]"}]}], ",", 
       RowBox[{"xAct`xIdeal`Private`m", "=", 
        RowBox[{
        "xAct`xIdeal`Private`params", "\[LeftDoubleBracket]", "1", 
         "\[RightDoubleBracket]"}]}]}], "}"}], ",", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "xAct`xIdeal`Private`R", "}"}], ",", 
       RowBox[{
        RowBox[{"xAct`xIdeal`Private`R", "=", 
         RowBox[{"Function", "[", 
